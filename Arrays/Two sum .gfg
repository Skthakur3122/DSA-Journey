class Solution {     //using hashset
    boolean twoSum(int arr[], int target) {
        HashSet<Integer> set=new HashSet<>();
        
        for (int ele: arr){
            int rem=target-ele;
            
            if(set.contains(rem)) return true;
            set.add(ele);
            
        }
        return false;
       
        
    }
}

// leetcode using two pointer


class Solution {
    public int[] twoSum(int[] arr, int target) {
        int n= arr.length;
        for (int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(arr[i]+arr[j]==target)
               return new int[]{i,j}; 

            }
        }
        return new int[] {};
        
    }
}

import java.util.Arrays;

class Solution {
    boolean twoSum(int arr[], int target) {

        int n = arr.length;

        Arrays.sort(arr);

        int i = 0;
        int j = n - 1;

        while (i < j) {

            int sum = arr[i] + arr[j];

            if (sum > target) {
                j--;
            }
            else if (sum < target) {
                i++;
            }
            else {
                return true;
            }
        }

        return false;
    }
}
