/* Structure of Linked List Node
class Node {
    int data;
    Node next;

    Node(int x) {
        data = x;
        next = null;
    }
}
*/
class Solution {
    public Node insertPos(Node head, int pos, int val) {
        
       
        
        Node t = new Node(val);
        
        if(pos == 1) {
             t.next = head;
             return t;
        }
        
         Node temp = head;
         
         for(int i=1 ; i<pos-1; i++){
             
             temp = temp.next;
             
         }
         
         t.next = temp.next;
          temp.next=t;
          
          return head;
     
    }
    
}