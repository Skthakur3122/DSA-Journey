/*
class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}*/

class Solution {
    public boolean isPalindrome(Node head) {
     
     if (head == null || head.next == null)
                 return true;

             // Find middle
             Node slow = head;
             Node fast = head;

             while (fast != null && fast.next != null) {
                 slow = slow.next;
                 fast = fast.next.next;
             }

             // Reverse second half
             Node prev = null;
             Node curr = slow;

             while (curr != null) {
                 Node temp = curr.next;
                 curr.next = prev;
                 prev = curr;
                 curr = temp;
             }

             // Compare both halves
             Node i = head;
             Node j = prev;

             while (j != null) {
                 if (i.data != j.data)
                     return false;

                 i = i.next;
                 j = j.next;
             }

             return true;
        
    }
}