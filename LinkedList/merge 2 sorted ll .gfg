/*
class Node
{
    int data;
    Node next;
    Node(int d) {
        data = d;
        next = null;
    }
}
*/

class Solution {
    Node sortedMerge(Node head1, Node head2) {
        
        Node dummy = new Node(-1);
        Node temp= dummy;
        Node i = head1;
        Node j = head2;
        
        while(i != null && j != null){
        
        if( i.data < j.data){
             temp.next=i;
             i=i.next;
        }    
        else{
            temp.next = j;
            j=j.next;
        }
        temp = temp.next;
        
        // Attach remaining nodes
           if(i != null) {
               temp.next = i;
           } 
           else {
               temp.next = j;
           }
    }
         return dummy.next;
    }
}