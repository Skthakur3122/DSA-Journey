class Solution {
    int floorSqrt(int n) {
        
        int lo = 1, hi = n; 
        while (lo <= hi) { 
            
            int mid = lo + (hi - lo) / 2; 
            if (mid <= n / mid) { 
                lo = mid + 1; 
                
            } 
            else {
                hi = mid - 1;
            } 
            
        }
            return hi;
        
        
    }
}