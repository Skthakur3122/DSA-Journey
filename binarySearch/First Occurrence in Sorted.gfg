class Solution {
    public int firstSearch(int[] arr, int k) {

        int n = arr.length;
        int idx = -1;
        int left = 0;
        int right = n - 1;

        while (left <= right) {
            int mid = (left + right) / 2;

            if (arr[mid] == k) {
                idx = mid;
                right = mid - 1;
            }
            else if (arr[mid] < k) {
                left = mid + 1;
            }
            else {
                right = mid - 1;
            }
        }

        return idx;
    }
}