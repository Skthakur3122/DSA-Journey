class Solution {
    public static int gcd(int a, int b) {
        
        // int hcf =1;
        
        // for(int i=2;i<=Math.min(a,b);i++){
        //     if(a%i == 0 && b%i ==0)
            
        //         hcf=i;
        // }
        // return hcf;
        

        //other approch
        if(a==0) return b; //recursion
        
        
        return gcd(b%a,a);
    }
}
