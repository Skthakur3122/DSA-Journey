class Solution {
    public Node reverseCircular(Node head) {
      
      Node temp = head;
      
      while( temp.next != head){
          temp = temp.next;
      }
        temp.next = null;
     
         Node prev = null;
            Node curr = head;
            Node fwd = head;
            
            while( curr != null){
                
                fwd = curr.next;
                curr.next= prev;
                prev = curr;
                curr = fwd;
            }
            
         head.next = prev;
         
         return prev;
                
        
          
    }
}