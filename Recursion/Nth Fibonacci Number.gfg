class Solution {
    static int nthFibonacci(int n) {
        // code here
        
        if(n==0 || n == 1) return n; //recursive 
        
        // return  nthFibonacci(n-1) + nthFibonacci(n-2);
        
               int a = 0; //iterative
               int b = 1;

               for (int i = 2; i <= n; i++) {
                   int c = a + b;
                   a = b;
                   b = c;
               }

               return b;
    }
}