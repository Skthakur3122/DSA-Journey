class Solution {
    public int matrixScore(int[][] arr) {

        int m = arr.length;
        int n = arr[0].length;

        // Step 1: Make the first column all 1s
        for (int i = 0; i < m; i++) {
            if (arr[i][0] == 0) {
                for (int j = 0; j < n; j++) {
                    arr[i][j] ^= 1;
                }
            }
        }

        // Step 2: For every column, make 1s >= 0s
        for (int j = 0; j < n; j++) {

            int zeros = 0;
            int ones = 0;

            for (int i = 0; i < m; i++) {
                if (arr[i][j] == 0)
                    zeros++;
                else
                    ones++;
            }

            if (zeros > ones) {
                for (int i = 0; i < m; i++) {
                    arr[i][j] ^= 1;
                }
            }
        }

        // Step 3: Calculate score
        
        int sum = 0;
        int pow = 1;

        for (int j = n - 1; j >= 0; j--) {

            int ones = 0;

            for (int i = 0; i < m; i++) {
                if (arr[i][j] == 1)
                    ones++;
            }

            sum += pow * ones;
            pow *= 2;
        }

        return sum;
    }
}