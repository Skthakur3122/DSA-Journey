class Solution {
    
     boolean isPowerOfTwo(int n){
         return n > 0 && (n &  (n-1))==0;
     }
     
       boolean isSquareRoot(int n){
           int root = (int) Math.sqrt(n);
         return (root * root ==n );
     }
     
    
    boolean isPowerOfFour(int n) {
     
     return  isPowerOfTwo( n) &&  isSquareRoot( n);
        
    }
}