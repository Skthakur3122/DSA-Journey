class Solution {
    public void reverseQueue(Queue<Integer> q) {
        
          int n = q.size();
        Stack<Integer> st= new Stack<>();
        
        for(int i=0; i<n; i++){
            st.push(q.remove());
            
        }
        for(int i=0; i<n; i++){
            q.add(st.pop());
        }
    }
}