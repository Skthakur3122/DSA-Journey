class Solution {
    public void rearrangeQueue(Queue<Integer> q) {
        
        int n=q.size();
        int[] arr= new int[n/2];
        
      for(int i=0; i<n/2; i++){
          q.add(q.remove());
          
      }
      
      for(int i=0; i<n/2; i++){
          arr[i] = q.remove();
      }
      
      for(int i =0; i<n/2; i++){
          q.add(q.remove());
          q.add(arr[i]);
      }
        
    }
}
